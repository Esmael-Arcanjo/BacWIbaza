# ==========================================
# 🗄️ BASE DE DADOS (MongoDB)
# ==========================================
# URL de ligação à base de dados MongoDB (atualmente a apontar para o servidor local)
MONGO_URL="mongodb://localhost:27017"

# Nome da base de dados onde os dados do marketplace serão guardados
DB_NAME="wibaza_marketplace"


# ==========================================
# 🔐 AUTENTICAÇÃO E SEGURANÇA
# ==========================================
# Domínios autorizados a fazer pedidos à API (CORS). 
# "*" permite qualquer origem (ideal para desenvolvimento local, mas deve ser restrito em produção)
CORS_ORIGINS="https://wibaza.com"

# Chave secreta para assinar e validar Tokens JWT (tokens de sessão dos utilizadores)
JWT_SECRET="a3f8c7d4e9b2a1f6c8d5e7b3a9f4c2d8e6b1a7f3c9d4e8b2a6f1c7d3e9b5a4f2"

# Credenciais iniciais/padrão da conta de Administrador do sistema
ADMIN_EMAIL="admin@wibaza.com"
ADMIN_PASSWORD="Admin@2026Wibaza"


# ==========================================
# 💳 PAGAMENTOS (Stripe)
# ==========================================
# Chave privada do Stripe (usada no backend para processar cobranças)
STRIPE_SECRET_KEY="sk_test_emergent"

# Chave pública do Stripe (usada no frontend para carregar formulários de cartão)
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# Chave de validação de Webhooks do Stripe (garante que eventos de pagamento vêm mesmo do Stripe)
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Modo de operação do Stripe ("test" para testes de desenvolvimento, "live" para pagamentos reais)
STRIPE_MODE="test"


# ==========================================
# 📧 ENVIOS DE E-MAIL (Resend)
# ==========================================
# Chave de API para autenticação no serviço Resend
RESEND_API_KEY="re_Jyys8fgg_K9eitZ5s1kQ4dz56ritxQhwr"

# Endereço de e-mail que aparecerá como remetente ("De:") nas mensagens enviadas
SENDER_EMAIL="support@wibaza.com"


# ==========================================
# 🤖 INTELIGÊNCIA ARTIFICIAL (IA)
# ==========================================
# Chave de API para utilizar os serviços/modelos da OpenAI ou do Gemini (conforme o que configurou)
OPENAI_API_KEY="sk-test-openai-placeholder"
# GEMINI_API_KEY="AIzaSy_SUA_CHAVE_AQUI" # (Descomente esta linha se decidir usar o Google Gemini)


# ==========================================
# 🌐 REDIRECIONAMENTO E LINKS (Frontend)
# ==========================================
# URL onde o seu site/interface de utilizador está a correr (usado para links de e-mail e retornos de pagamento)
FRONTEND_URL="http://localhost:3000"